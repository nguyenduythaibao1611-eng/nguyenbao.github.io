<section class="beta-products-list" aria-labelledby="top-products-title">
    <h2 id="top-products-title">Top Products</h2>
    <p class="beta-products-details"><%= products.length %> styles found</p>
    <div class="product-list">
        <% if (products.length === 0) { %>
            <p class="empty-products">No top products found.</p>
        <% } %>
        <% products.forEach(product => { %>
            <%- include('product-card', { product }) %>
        <% }) %>
    </div>
</section>